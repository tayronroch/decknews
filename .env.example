# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=decknews
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5430/decknews?schema=public"
# Max simultaneous connections Prisma will open to PostgreSQL (default: 10).
DATABASE_POOL_SIZE=20

# App
NODE_ENV="development"
PORT=3000
# APP_URL is optional in development (defaults to http://localhost:PORT).
# Set this in production to the public URL of the application (e.g. https://decknews.com).
APP_URL=
