# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=decknews
# Em produção, a aplicação força sslmode=require para conexões PostgreSQL.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5430/decknews?schema=public"
# Max simultaneous connections Prisma will open to PostgreSQL (default: 10).
DATABASE_POOL_SIZE=20

# App
NODE_ENV="development"
PORT=3000
# APP_URL is optional in development (defaults to http://localhost:PORT).
# Set this in production to the public URL of the application (e.g. https://decknews.com).
APP_URL=

# Security - Password Hashing (Argon2id Pepper)
# Gerar com: openssl rand -base64 32
PASSWORD_PEPPER=
# PASSWORD_PEPPER_PREVIOUS=

# Session Expiration (Optional, default: 604800 / 7 days)
# SESSION_TTL_IN_SECONDS=604800

# Optional secret token required to execute remote database migrations via /api/v1/admin/migrations
MIGRATION_TOKEN=change-me-to-a-secure-random-secret-with-at-least-16-chars

# Uso único em produção no container com: node infra/scripts/bootstrap-admin.mjs
# Remova estas variáveis após confirmar o acesso administrativo.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
